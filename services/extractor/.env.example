# Ver TORI-CREDENTIALS.md para de dónde sale cada valor y el alcance mínimo a pedir.

# Infra compartida
REDIS_URL=

# Google Places API (New) — key restringida a esta sola API + IP del servidor
GOOGLE_PLACES_API_KEY=

# Apify — solo si Places API no alcanza. Token "Limited", scopeado al Actor de Maps Scraper
APIFY_API_TOKEN=

# Auth interna de POST /runs — random, no viene de ningún proveedor externo
TORI_INTERNAL_API_KEY=
