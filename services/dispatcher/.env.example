# Ver TORI-CREDENTIALS.md para de dónde sale cada valor y el alcance mínimo a pedir.
# Solo cargar las variables del output que use cada tenant — no todas a la vez.

# Infra compartida
REDIS_URL=

CONSUMER_GROUP=dispatcher-cg
CONSUMER_NAME=dispatcher-1
RETRY_BASE_BACKOFF_MS=5000
MAX_RETRIES=5

# Límites reales por defecto — ajustar según el plan de cada proveedor/tenant
AIRTABLE_RATE_LIMIT_PER_SECOND=5
SHEETS_RATE_LIMIT_PER_MINUTE=60

# Airtable — token scopeado SOLO a la base del cliente, data.records:read + data.records:write
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=

# Google Sheets — service account compartido solo con el spreadsheet puntual del cliente
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# CRM del cliente — TBD, sin definir hasta el primer caso real
CRM_TYPE=
CRM_API_KEY=
