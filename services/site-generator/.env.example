# Ver TORI-CREDENTIALS.md
REDIS_URL=

CONSUMER_GROUP=site-generator-cg
CONSUMER_NAME=site-generator-1
RETRY_BASE_BACKOFF_MS=5000
MAX_RETRIES=5

# Vercel — token de deploy. Ver https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_NAME=tori-leads

# Aprobado en CLAUDE.md sección 9 (documento de validación, 2026-09-18) — no subir sin
# volver a pasar por esa validación.
WEEKLY_QUOTA=50
EXPIRY_DAYS=14

# Sitio generado con Gemini. Sin GEMINI_API_KEY se usa la plantilla fija (sin IA ni fotos).
GEMINI_API_KEY=
SITE_GEN_MODEL=gemini/gemini-3.1-pro-preview

# Fotos de Google Places (opcional, requiere las dos keys; sin ellas el sitio sale sin fotos).
# GOOGLE_PLACES_API_KEY: la misma key de servidor de extractor (metadatos de fotos).
# GOOGLE_PLACES_PUBLIC_KEY: queda EXPUESTA en el HTML público -- crear una key NUEVA en GCP,
# restringida a "Places API (New)" y a HTTP referrers https://*.vercel.app/*. Nunca reusar la
# key de servidor acá. Ver TORI-CREDENTIALS.md.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PUBLIC_KEY=
MAX_PHOTOS=5
